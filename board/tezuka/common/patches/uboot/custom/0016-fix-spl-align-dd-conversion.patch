From: Codex <noreply@openai.com>
Subject: [PATCH] scripts: Makefile.xpl: remove invalid block conversion from SPL alignment

GNU dd requires cbs= when conv=block is selected. This rule only needs to
pad the final input block to the four-byte alignment, which conv=sync does.

--- a/scripts/Makefile.xpl
+++ b/scripts/Makefile.xpl
@@ -256,7 +256,7 @@ endif
 endif
 
 $(obj)/$(SPL_BIN)-align.bin: $(obj)/$(SPL_BIN).bin
-	@dd if=$< of=$@ conv=block,sync bs=4 2>/dev/null;
+	@dd if=$< of=$@ conv=sync bs=4 2>/dev/null;
 
 spl/boot.bin: $(obj)/$(SPL_BIN)-align.bin FORCE
 	$(call if_changed,mkimage)
